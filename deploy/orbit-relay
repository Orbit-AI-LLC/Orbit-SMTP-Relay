#!/bin/sh
# The relay's command, installed by install.sh as /usr/local/bin/orbit-relay.
#
# It runs the source checkout with the system Python, whose
# python3-cryptography is the agent's one dependency, so nothing comes from
# PyPI. -P keeps the current directory off the import path: root runs this
# from wherever it happens to be.
PYTHONPATH=/opt/orbit-relay exec /usr/bin/python3 -P -m relay.cli "$@"
